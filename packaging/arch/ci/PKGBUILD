# Maintainer: William C. Canin
pkgname=argvus-control-center
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal control center for the ARGVUS desktop."
arch=('x86_64')
url="https://github.com/argvus/argvus-control-center"
license=('GPL-3.0-only')
depends=(
  'argvus-config'
  'argvus-accounts'
  'argvus-firewall'
  'argvus-i18n'
  'argvus-notifications'
  'argvus-power'
  'fontconfig'
  'gcc-libs'
  'glibc'
  'foot'
  'polkit'
  'reflector'
  'systemd'
  'wireplumber'
  'xkeyboard-config'
  'xdg-utils'
)
optdepends=('argvus-language-pt-br: Brazilian Portuguese translations')
makedepends=('cargo')
options=('!debug')
backup=('etc/argvus/control-center/config.toml')
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
  "argvus-i18n-main.tar.gz::https://github.com/argvus/argvus-i18n/archive/refs/heads/main.tar.gz"
  "argvus-tui-main.tar.gz::https://github.com/argvus/argvus-tui/archive/refs/heads/main.tar.gz"
)
sha256sums=('SKIP' 'SKIP')

_source_dir() {
  printf '%s/%s' "$srcdir" "${pkgname}-${pkgver}"
}

prepare() {
  mv "$srcdir/argvus-i18n-main" "$srcdir/argvus-i18n"
  mv "$srcdir/argvus-tui-main" "$srcdir/argvus-tui"
  cd "$(_source_dir)"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "$(_source_dir)"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  cargo build --release --locked --workspace --target-dir target
}

check() {
  cd "$(_source_dir)"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  env -u LC_ALL -u LC_MESSAGES -u LANGUAGE LANG=pt_BR.UTF-8 \
    cargo test --locked --workspace --target-dir target
}

package() {
  cd "$(_source_dir)"
  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  ln -s "${pkgname}" "${pkgdir}/usr/bin/argvus-controle-center"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 assets/argvus-about.svg \
    "${pkgdir}/usr/share/argvus-control-center/argvus-about.svg"
  install -Dm644 packaging/arch/usr/share/applications/argvus-control-center.desktop \
    "${pkgdir}/usr/share/applications/argvus-control-center.desktop"
  install -dm755 "${pkgdir}/usr/share/argvus/control-center"
  cp -R --no-preserve=ownership src/usr/share/argvus/control-center/. \
    "${pkgdir}/usr/share/argvus/control-center/"
  install -Dm644 src/usr/share/argvus/control-center/config/config.toml \
    "${pkgdir}/etc/argvus/control-center/config.toml"
  install -Dm644 src/usr/share/argvus/control-center/docs/README.md \
    "${pkgdir}/usr/share/argvus/control-center/docs/README.md"
}
