# Maintainer: William C. Canin
pkgname=argvus-control-center
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal control center for the ARGVUS desktop."
arch=('x86_64')
url="https://github.com/argvus/argvus-control-center"
license=('GPL-3.0-only')
depends=(
  'argvus-accounts'
  'argvus-firewall'
  'fontconfig'
  'gcc-libs'
  'glibc'
  'foot'
  'polkit'
  'systemd'
  'xkeyboard-config'
  'xdg-utils'
)
makedepends=(
  'cargo'
)
options=('!debug')
backup=('etc/argvus/control-center/config.toml')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  if [[ ! -f "$srcdir/argvus-i18n/Cargo.toml" ]]; then
    error "argvus-i18n source is missing from the local source archive"
    return 1
  fi
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  cargo build --release --locked --workspace --target-dir target
}

check() {
  cd "${pkgname}-${pkgver}"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  env -u LC_ALL -u LC_MESSAGES -u LANGUAGE LANG=pt_BR.UTF-8 \
    cargo test --locked --workspace --target-dir target
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install-files
}
